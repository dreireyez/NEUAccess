
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a university member, storing their profile and institutional access role.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier (Firebase Auth UID)."
        },
        "email": {
          "type": "string",
          "description": "Institutional email (@neu.edu.ph).",
          "format": "email"
        },
        "displayName": {
          "type": "string",
          "description": "The user's full name from Google Auth."
        },
        "role": {
          "type": "string",
          "enum": ["admin", "staff", "user"],
          "description": "Access level: admin (full control), staff (logs access), user (student)."
        },
        "college": {
          "type": "string",
          "description": "Academic college/department selected during onboarding."
        },
        "isBlocked": {
          "type": "boolean",
          "description": "Administrative flag to prevent library access."
        }
      },
      "required": ["id", "email", "role", "isBlocked"]
    },
    "Visit": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Visit",
      "type": "object",
      "description": "A single library visit record from time-in to time-out.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique Visit ID."
        },
        "userId": {
          "type": "string",
          "description": "UID of the visiting member."
        },
        "timeIn": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of entry."
        },
        "timeOut": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of exit (null if active)."
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of purposes selected (e.g., Reading, Research)."
        },
        "status": {
          "type": "string",
          "enum": ["active", "completed"],
          "description": "Current state of the visit."
        }
      },
      "required": ["id", "userId", "timeIn", "reasons", "status"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "Profiles of university members."
    },
    "/visits/{visitId}": {
      "schema": { "$ref": "#/backend/entities/Visit" },
      "description": "Historical and active library visit logs."
    },
    "/roles_admin/{userId}": {
      "schema": { "type": "object" },
      "description": "Lookup for administrative privileges."
    },
    "/roles_staff/{userId}": {
      "schema": { "type": "object" },
      "description": "Lookup for library staff privileges."
    }
  }
}
