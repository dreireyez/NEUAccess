rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * NEU Library Visitor App Security Rules
     * 
     * Core Philosophy:
     * This ruleset implements a strict identity-based access model complemented by role-based lookups. 
     * Security is enforced through structural segregation and data denormalization.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isStaff() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_staff/$(request.auth.uid));
    }

    // --- Collection Rules ---

    /**
     * @description Rules for the User collection.
     * Admins/Staff can list and read all.
     * Owners can only create themselves as 'user' role.
     * Owners cannot change their own 'role' or 'isBlocked' status.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin() || isStaff();
      allow list: if isAdmin() || isStaff();
      allow create: if isOwner(userId) 
                    && request.resource.data.id == userId 
                    && request.resource.data.role == "user"
                    && request.resource.data.isBlocked == false;
      allow update: if isAdmin() || (
        isOwner(userId) 
        && request.resource.data.id == resource.data.id
        && request.resource.data.role == resource.data.role
        && request.resource.data.isBlocked == resource.data.isBlocked
      );
      allow delete: if isAdmin();
    }

    /**
     * @description Rules for Visit records.
     * Users can only list their own visits.
     * Admins/Staff can list all.
     */
    match /visits/{visitId} {
      allow get: if isAdmin() || isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || isStaff() || (isSignedIn() && request.query.filters.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Administrative role lookup.
     */
    match /roles_admin/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
    }

    /**
     * @description Staff role lookup.
     */
    match /roles_staff/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin() || isStaff();
    }
  }
}